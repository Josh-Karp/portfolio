---
import { faq } from "../data/cv";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
---

<Section label="Questions" id="questions">
    <SectionHead kanji="問" title="Common questions." />

    <div>
        {faq.map((item, i) => (
            <details
                open={i === 0}
                class="group border-b border-line first:border-t first:border-line"
            >
                <summary class="relative cursor-pointer list-none py-4.75 pr-8.5 text-[15.5px] text-ink transition-colors marker:hidden hover:text-bone after:absolute after:top-4.25 after:right-1 after:font-mono after:text-[15px] after:text-ink-faint after:content-['+'] group-open:after:content-['–'] [&::-webkit-details-marker]:hidden">
                    {item.q}
                </summary>
                <div class="max-w-[70ch] pb-5.5 text-[13.5px] leading-[1.8] text-ink-muted">
                    {item.a}
                </div>
            </details>
        ))}
    </div>
</Section>
