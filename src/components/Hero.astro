---
import { profile, spec, stats } from "../data/cv";
import Eyebrow from "./Eyebrow.astro";
import PortraitPlate from "./PortraitPlate.astro";
---

<section id="top" class="relative">
    <div class="shell relative z-1 grid grid-cols-1 pt-[clamp(34px,6vw,60px)] pb-[clamp(40px,7vw,78px)] md:grid-cols-[clamp(0px,5vw,64px)_minmax(0,1fr)]">
        <div class="relative hidden md:block">
            <span class="sticky top-24 block rotate-180 font-mono text-[8.5px] uppercase tracking-[0.3em] text-ink-faint [writing-mode:vertical-rl]">
                Dossier · 001
            </span>
        </div>

        <div class="grid min-w-0 grid-cols-1 items-start gap-[clamp(24px,5vw,64px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.02fr)]">
            <div>
                <Eyebrow kanji={profile.mark} label="Engineer dossier" bar />

                <h1 class="display text-[clamp(52px,9.4vw,96px)] leading-[0.94]">
                    {profile.name}
                </h1>

                <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.2em] text-ink-muted">
                    {profile.title} · {profile.location}
                </p>

                <p class="mt-2 flex items-center gap-1.75">
                    <span
                        class="h-1.25 w-1.25 rounded-full bg-bone"
                        aria-hidden="true"
                    ></span>
                    <span class="mono">
                        Local <span data-clock="long">—</span>
                    </span>
                </p>

                <dl class="mt-7.5 border-t border-line-soft">
                    {spec.map((row) => (
                        <div class="flex items-baseline justify-between gap-4 border-b border-line-soft py-2.25">
                            <dt class="mono">{row.label}</dt>
                            <dd class="m-0 text-right font-display text-[17px] text-ink">
                                {row.value}
                            </dd>
                        </div>
                    ))}
                </dl>

                <div class="mt-6.5 grid grid-cols-2 border-t border-l border-line sm:grid-cols-4">
                    {stats.map((stat) => (
                        <div class="border-r border-b border-line px-3.25 py-3">
                            <b class="block font-display text-[26px] leading-none font-normal">
                                {stat.value}
                            </b>
                            <span class="mono mt-1.75 block text-[8px] tracking-[0.18em]">
                                {stat.label}
                            </span>
                        </div>
                    ))}
                </div>

                <div class="mt-5.5 flex flex-wrap gap-2">
                    <a class="btn btn-solid" href={`mailto:${profile.email}`}>
                        Start a conversation
                    </a>
                    <a class="btn" href="#work">
                        Read the record
                    </a>
                </div>

                <div class="mt-7 flex items-end justify-between gap-5">
                    <div
                        class="barcode h-10.5 max-w-70 flex-1 opacity-50"
                        aria-hidden="true"
                    ></div>
                    <div class="text-right">
                        <span class="mono">Filed under</span>
                        <em class="block font-display text-[20px] not-italic text-ink">
                            Full-stack
                        </em>
                    </div>
                </div>
            </div>

            <PortraitPlate />
        </div>
    </div>
</section>
