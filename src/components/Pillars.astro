---
import { pillars } from "../data/cv";
import Section from "./Section.astro";
import Eyebrow from "./Eyebrow.astro";
---

<Section label="Practice">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-[clamp(24px,5vw,72px)]">
        {pillars.map((pillar) => (
            <div>
                <Eyebrow kanji={pillar.kanji} label={pillar.eyebrow} />
                <h3 class="display mb-3 text-[clamp(30px,4.2vw,44px)] leading-[1.15]">
                    {pillar.title}
                </h3>
                <p class="lede">{pillar.body}</p>
                <ul class="mt-5 list-none border-t border-line-soft p-0">
                    {pillar.points.map((point, i) => (
                        <li class="flex gap-3 border-b border-line-soft py-2.25 text-[13.5px] text-ink-muted">
                            <b class="shrink-0 basis-6.5 pt-0.75 font-mono text-[9px] font-normal tracking-[0.16em] text-ink-faint">
                                {String.fromCharCode(65 + i)}
                            </b>
                            <span>{point}</span>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
</Section>
