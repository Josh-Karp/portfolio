---
import { toolkit } from "../data/cv";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
---

<Section label="Toolkit" id="toolkit">
    <SectionHead kanji="具" title="What's in the bag." />
    <p class="lede mb-7">
        Grouped the way it gets used, not the way it looks on a keyword scan.
    </p>

    <div class="border-t border-l border-line sm:hidden">
        {toolkit.map((group, index) => (
            <details
                open={index === 0}
                class="toolkit-disclosure group border-r border-b border-line"
            >
                <summary class="relative cursor-pointer list-none px-[18px] py-4.25 pr-20 marker:hidden [&::-webkit-details-marker]:hidden after:absolute after:top-1/2 after:right-[18px] after:-translate-y-1/2 after:font-mono after:text-[15px] after:text-ink-faint after:content-['+'] group-open:after:content-['–']">
                    <span class="mono">{group.group}</span>
                    <span class="mono absolute top-1/2 right-11.5 -translate-y-1/2 text-[8px] tracking-[0.16em]">
                        {group.items.length} tools
                    </span>
                </summary>
                <div class="toolkit-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-250 ease-out motion-reduce:transition-none group-open:grid-rows-[1fr]">
                    <div class="min-h-0 overflow-hidden">
                        <ul class="m-0 list-none border-t border-line-soft px-[18px] pb-[18px] pt-2.5">
                            {group.items.map((item) => (
                                <li class="border-b border-line-soft py-1.25 text-[13.5px] text-ink-muted last:border-b-0">
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </details>
        ))}
    </div>

    <div class="hidden border-t border-l border-line sm:grid sm:grid-cols-2 lg:grid-cols-3">
        {toolkit.map((group) => (
            <div class="border-r border-b border-line p-[clamp(18px,2.4vw,24px)]">
                <h4 class="mono mb-3.5">{group.group}</h4>
                <ul class="m-0 list-none p-0">
                    {group.items.map((item) => (
                        <li class="border-b border-line-soft py-1.25 text-[13.5px] text-ink-muted last:border-b-0">
                            {item}
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
</Section>

<style>
    @media (width < 40rem) {
        details:not([open]) > .toolkit-panel {
            display: grid;
        }

        details[data-closing] > .toolkit-panel {
            grid-template-rows: 0fr;
        }
    }
</style>

<script>
    const closingDuration = 250;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll<HTMLDetailsElement>(".toolkit-disclosure").forEach((details) => {
        const summary = details.querySelector("summary");
        const panel = details.querySelector<HTMLElement>(".toolkit-panel");

        if (!summary || !panel) return;

        summary.addEventListener("click", (event) => {
            if (!details.open || reducedMotion.matches) return;

            event.preventDefault();

            if (details.dataset.closing !== undefined) return;

            details.dataset.closing = "";
            let closingTimer: number | undefined;

            const finishClosing = () => {
                if (closingTimer !== undefined) window.clearTimeout(closingTimer);
                details.removeAttribute("open");
                delete details.dataset.closing;
            };

            panel.addEventListener(
                "transitionend",
                (transitionEvent) => {
                    if (transitionEvent.target === panel && transitionEvent.propertyName === "grid-template-rows") {
                        finishClosing();
                    }
                },
                { once: true },
            );

            closingTimer = window.setTimeout(finishClosing, closingDuration + 50);
        });
    });
</script>
