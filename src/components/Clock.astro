---
import { profile } from "../data/cv";
/**
 * Live local time. Fills every [data-clock] slot on the page.
 * Runs as a tiny inline island with no framework needed.
 */
---

<script is:inline define:vars={{ tz: profile.timezone }}>
    (() => {
        const shorts = document.querySelectorAll('[data-clock="short"]');
        const longs = document.querySelectorAll('[data-clock="long"]');
        if (!shorts.length && !longs.length) return;

        const tick = () => {
            const now = new Date().toLocaleTimeString("en-GB", {
                timeZone: tz,
                hour12: false,
            });
            shorts.forEach((el) => (el.textContent = now.slice(0, 5)));
            longs.forEach((el) => (el.textContent = now));
        };

        tick();
        setInterval(tick, 1000);
    })();
</script>
