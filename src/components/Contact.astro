---
import { profile, contact } from "../data/cv";
import Section from "./Section.astro";
import Eyebrow from "./Eyebrow.astro";

const fields = [
    { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
    { label: "Phone", value: profile.phone, href: profile.phoneHref },
    { label: "Based", value: "Pretoria, South Africa", href: null },
];
---

<Section label="Contact">
    <div class="grid grid-cols-1 items-start gap-[clamp(24px,5vw,64px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)]">
        <div>
            <Eyebrow kanji="信" label="Get in touch" />
            <h2 class="display text-[clamp(34px,5.4vw,58px)] leading-[1.02]">
                {contact.headline}
            </h2>
            <p class="lede mt-4.5">{contact.body}</p>
        </div>

        <div class="border border-line bg-panel p-[clamp(18px,3vw,26px)]">
            <div class="mt-4.5 flex justify-between">
                <span class="mono">Direct lines</span>
                <span class="mono">Pretoria · UTC+2</span>
            </div>

            {fields.map((field) => {
                const Tag = field.href ? "a" : "div";
                return (
                    <Tag
                        href={field.href ?? undefined}
                        class="group block border-b border-line py-3 no-underline first:border-t first:border-line"
                    >
                        <span class="mono block">{field.label}</span>
                        <span class="mt-0.75 block font-display text-[19px] wrap-break-word text-ink transition-colors group-hover:text-bone">
                            {field.value}
                        </span>
                    </Tag>
                );
            })}

            <a
                class="btn btn-solid mt-5"
                href={`mailto:${profile.email}?subject=Project%20enquiry`}
            >
                Write an email
            </a>
        </div>
    </div>
</Section>
