---
/**
 * Dot-matrix portrait plate. Pure SVG — no image asset, no network request.
 * Swap the <use href="#bust"> shape for a masked photo if you ever want one.
 */
---

<figure class="relative m-0 border border-line-soft p-3.5">
    <span
        class="absolute -top-px -left-px h-2.25 w-2.25 border-t border-l border-accent-faint"
        aria-hidden="true"
    ></span>
    <span
        class="absolute -top-px -right-px h-2.25 w-2.25 border-t border-r border-accent-faint"
        aria-hidden="true"
    ></span>
    <span
        class="absolute -bottom-px -left-px h-2.25 w-2.25 border-b border-l border-accent-faint"
        aria-hidden="true"
    ></span>
    <span
        class="absolute -right-px -bottom-px h-2.25 w-2.25 border-r border-b border-accent-faint"
        aria-hidden="true"
    ></span>

    <svg
        viewBox="0 0 400 500"
        role="img"
        aria-label="Dot-matrix portrait plate"
        class="block h-auto w-full"
    >
        <defs>
            <pattern
                id="dots"
                width="5"
                height="5"
                patternUnits="userSpaceOnUse"
            >
                <circle cx="2.5" cy="2.5" r="1.5" fill="#e9e5dc"></circle>
            </pattern>
            <pattern
                id="dotsFine"
                width="5"
                height="5"
                patternUnits="userSpaceOnUse"
            >
                <circle cx="2.5" cy="2.5" r=".85" fill="#e9e5dc"></circle>
            </pattern>
            <linearGradient id="fade" x1="0" y1="0" x2="1" y2="0.25">
                <stop offset="0" stop-color="#fff" stop-opacity=".95"></stop>
                <stop offset=".55" stop-color="#fff" stop-opacity=".45"></stop>
                <stop offset="1" stop-color="#fff" stop-opacity=".12"></stop>
            </linearGradient>
            <path
                id="bust"
                d="M200 62c58 0 84 44 84 92 0 30-6 55-15 75-6 15-18 29-32 37v28c0 8 8 14 20 20l74 34c32 16 44 46 48 84l4 42H17l4-42c4-38 16-68 48-84l74-34c12-6 20-12 20-20v-28c-14-8-26-22-32-37-9-20-15-45-15-75 0-48 26-92 84-92z"
            ></path>
            <clipPath id="bustClip">
                <use href="#bust"></use>
            </clipPath>
            <mask id="plateFade">
                <rect width="400" height="500" fill="url(#fade)"></rect>
            </mask>
        </defs>

        <circle
            cx="235"
            cy="196"
            r="168"
            fill="none"
            stroke="#55d6a0"
            stroke-opacity=".10"
        ></circle>

        <g mask="url(#plateFade)">
            <use href="#bust" fill="url(#dots)" opacity=".92"></use>
        </g>

        <g clip-path="url(#bustClip)">
            <rect
                x="240"
                y="0"
                width="160"
                height="500"
                fill="url(#dotsFine)"
                opacity=".35"
            ></rect>
            <rect
                x="0"
                y="0"
                width="120"
                height="500"
                fill="url(#dotsFine)"
                opacity=".2"
            ></rect>
        </g>

        <g stroke="#55d6a0" stroke-opacity=".18" fill="none">
            <path d="M18 108V88h20"></path>
            <path d="M382 108V88h-20"></path>
            <path d="M18 392v20h20"></path>
            <path d="M382 392v20h-20"></path>
        </g>

        <text
            x="18"
            y="76"
            fill="#6a675e"
            font-family="monospace"
            font-size="9"
            letter-spacing="2"
        >
            PLT—01
        </text>
        <text
            x="382"
            y="76"
            fill="#6a675e"
            font-family="monospace"
            font-size="9"
            letter-spacing="2"
            text-anchor="end"
        >
            HALFTONE
        </text>
    </svg>

    <figcaption class="mt-2.5 flex justify-between">
        <span class="mono">Portrait withheld · plate only</span>
        <span class="mono">基 · 盤</span>
    </figcaption>
</figure>
