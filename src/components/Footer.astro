---
import { profile, nav } from "../data/cv";
---

<footer class="relative z-1 mt-[clamp(20px,4vw,40px)] border-t border-line pt-[clamp(40px,6vw,64px)]">
    <div class="shell">
        <div class="grid grid-cols-2 gap-[clamp(24px,4vw,40px)] md:grid-cols-[minmax(0,1.5fr)_repeat(2,minmax(0,1fr))]">
            <div class="col-span-2 md:col-span-1">
                <span
                    class="font-display text-[30px] text-accent"
                    aria-hidden="true"
                >
                    {profile.mark}
                </span>
                <p class="mt-2 max-w-[20ch] font-display text-[18px] leading-[1.3]">
                    Built for the people who have to use it.
                </p>
            </div>

            <div>
                <h5 class="mono mb-3.5 font-normal">Page</h5>
                {nav.map((item) => (
                    <a
                        href={item.href}
                        class="block py-1.25 text-[13.5px] text-ink-muted no-underline transition-colors hover:text-accent"
                    >
                        {item.label}
                    </a>
                ))}
            </div>

            <div>
                <h5 class="mono mb-3.5 font-normal">Reach</h5>
                <a
                    href={`mailto:${profile.email}`}
                    class="block py-1.25 text-[13.5px] text-ink-muted no-underline transition-colors hover:text-accent"
                >
                    {profile.email}
                </a>
                <a
                    href={profile.phoneHref}
                    class="block py-1.25 text-[13.5px] text-ink-muted no-underline transition-colors hover:text-accent"
                >
                    {profile.phone}
                </a>
                <a
                    href="#top"
                    class="block py-1.25 text-[13.5px] text-ink-muted no-underline transition-colors hover:text-accent"
                >
                    Back to top
                </a>
            </div>
        </div>

        <div
            class="mt-[clamp(36px,6vw,60px)] overflow-hidden text-center font-display text-[clamp(50px,14.2vw,190px)] leading-[0.8] whitespace-nowrap text-transparent [-webkit-text-stroke:1px_rgb(233_229_220/0.16)]"
            aria-hidden="true"
        >
            {profile.name.toUpperCase()}
        </div>

        <div class="flex flex-wrap justify-between gap-3.5 pt-5.5 pb-7.5">
            <span class="mono">
                © {new Date().getFullYear()} {profile.name} · {profile.title}
            </span>
            <span
                class="inline-flex h-6.5 w-6.5 items-center justify-center border border-accent-faint font-display text-[14px] text-accent"
                aria-hidden="true"
            >
                {profile.mark}
            </span>
            <span class="mono">Curriculum vitae · single page</span>
        </div>
    </div>
</footer>
